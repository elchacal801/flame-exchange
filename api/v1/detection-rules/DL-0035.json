  "data": {
    "id": "cbadea79-ead5-4450-bc9e-843779bc773b",
    "dl_id": "DL-0035",
    "title": "Wire to FATF High-Risk Jurisdiction",
    "status": "experimental",
    "description": "Detects wire transfers to jurisdictions on the FATF high-risk or increased monitoring lists. While not inherently fraudulent, wires to these jurisdictions combined with other risk factors (new beneficiary, unusual amount, after-hours) significantly elevate the risk of money laundering or fraud monetization.\n",
    "cfpf_phase": "P4",
    "level": "high",
    "detection": {
      "selection": {
        "event_type": "WIRE_INITIATION",
        "wire_type": "international",
        "beneficiary_country": [
          "MM",
          "KP",
          "IR",
          "YE",
          "SY",
          "HT",
          "VU",
          "PH",
          "NG",
          "SS"
        ],
        "transaction_amount|gte": 1000
      },
      "filter_established_relationship": {
        "beneficiary_relationship_days|gte": 365,
        "prior_transaction_count|gte": 10
      },
      "condition": "selection and not filter_established_relationship"
    },
    "logsource": {
      "product": "banking",
      "service": "wire_system"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "beneficiary_country",
        "event_type",
        "transaction_amount",
        "wire_type"
      ],
      "enrichment_required": [
        {
          "field": "beneficiary_relationship_days",
          "source": "Relationship analytics enrichment (beneficiary tenure calculation)"
        },
        {
          "field": "prior_transaction_count",
          "source": "Account analytics enrichment (historical transaction count)"
        }
      ]
    },
    "references": [
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf",
      "https://www.fatf-gafi.org/en/countries/black-and-grey-lists.html"
    ],
    "threat_path_ids": [
      "TP-0006",
      "TP-0020"
    ],
    "fraud_types": [
      "payment-diversion",
      "wire-fraud"
    ],
    "tags": [
      "attack.t1657",
      "cfpf.phase4.execution",
      "flame.wire_ach"
    ],
    "falsepositives": [
      "NGOs and charitable organizations with legitimate operations in high-risk countries",
      "International companies with established supply chains in monitored jurisdictions"
    ]
  }
}