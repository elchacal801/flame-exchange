    "title": "Micro-Splitting Stablecoin Donations to Rotating Wallets",
    "status": "experimental",
    "description": "Detect patterns of small-value stablecoin transfers ($10-$500) sent to wallets that are used only once or twice before rotating to new addresses. Models the ISIL/Al-Qaeda donation solicitation pattern: rotating wallet addresses, micro-splitting, and multi-hop transfers designed to evade transaction monitoring thresholds.\n",
    "cfpf_phase": "P5",
    "level": "medium",
    "detection": {
      "selection": {
        "amount_usd|gte": 10,
        "amount_usd|lte": 500,
        "token_type|re": "USDT|USDC|DAI",
        "destination_wallet_lifetime_tx_count|lte": 2,
        "destination_wallet_age_hours|lte": 168
      },
      "aggregation": {
        "function": "count()",
        "group_by": "sender_cluster",
        "timeframe": "7d",
        "threshold|gte": 5
      },
      "condition": "selection and aggregation"
    },
    "logsource": {
      "product": "crypto",
      "service": "transaction_monitoring"
    },
