    "title": "Election-Cycle Domain Registration Spike",
    "status": "experimental",
    "description": "Detect anomalous increases in domain registrations containing financial institution brand names or financial services keywords during election periods. Compares registration volumes against a 90-day rolling baseline, alerting on 3x+ increases within 30 days of scheduled elections. Integrates with election calendar data for predictive detection.\n",
    "cfpf_phase": "P1",
    "level": "medium",
    "detection": {
      "selection": {
        "registration_volume_ratio|gte": 3.0,
        "baseline_window": "90d",
        "domain_name|contains": [
          "financial_brand_keywords"
        ],
        "registration_date_within_election|lte": "30d"
      },
      "condition": "selection"
    },
