    "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
    "dl_id": "DL-0115",
    "title": "DaaS Platform Transaction Pattern",
    "status": "experimental",
    "description": "Detect cryptocurrency transactions matching Deepfake-as-a-Service (DaaS) subscription patterns: recurring payments of $100-$1,000/month to wallets associated with known deepfake service providers, or one-time payments of $50-$500 for per-use deepfake generation services. These patterns indicate procurement of deepfake tooling used in downstream fraud operations including identity verification bypass and social engineering.\n",
    "cfpf_phase": "P1",
    "level": "medium",
    "detection": {
      "selection_recurring": {
        "payment_type": "recurring",
        "recurring_payment_amount|gte": 100,
        "recurring_payment_amount|lte": 1000,
        "recurring_payment_currency": "USD",
        "recurring_payment_interval": "monthly",
        "destination_wallet_flag|contains": [
          "deepfake_service",
          "daas_provider"
        ]
      },
      "selection_onetime": {
        "payment_type": "one-time",
        "transaction_amount|gte": 50,
        "transaction_amount|lte": 500,
        "destination_wallet_flag|contains": [
          "deepfake_service",
          "daas_provider"
        ]
      },
      "condition": "selection_recurring or selection_onetime"
    },
    "logsource": {
      "product": "crypto",
      "service": "blockchain_analytics"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "payment_type",
        "recurring_payment_amount",
        "recurring_payment_currency",
        "recurring_payment_interval",
        "transaction_amount",
        "destination_wallet_flag"
      ],
      "enrichment_required": [
        {
          "field": "destination_wallet_flag",
          "source": "Threat intelligence enrichment (known DaaS provider wallet attribution)"
        }
      ]
    },
    "threat_path_ids": [
      "TP-0057"
    ],
    "fraud_types": [
      "deepfake-as-a-service",
      "fraud-as-a-service"
    ],
    "tags": [
