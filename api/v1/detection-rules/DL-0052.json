  "data": {
    "id": "2559ff0f-dfe6-4001-9d12-aaac8396b5c1",
    "dl_id": "DL-0052",
    "title": "Audio Compression Artifacts Indicative of AI-Generated Speech",
    "status": "experimental",
    "description": "Detects audio streams exhibiting compression artifacts, spectral anomalies, or frequency-band irregularities characteristic of AI-generated or text-to-speech synthesis engines. These include unnaturally uniform pitch contours, missing micro-pauses, absence of breath sounds, and codec artifacts from re-encoding through real-time deepfake pipelines.\n",
    "cfpf_phase": "P4",
    "level": "critical",
    "detection": {
      "selection": {
        "event_type": "voice_stream_analysis"
      },
      "filter_artifacts": {
        "spectral_flatness_score|gt": 0.85,
        "breath_sound_detected": false,
        "pitch_variance|lt": 2.5
      },
      "filter_codec": {
        "codec_reencoding_detected": true
      },
      "condition": "selection and (filter_artifacts or filter_codec)"
    },
    "logsource": {
      "product": "banking",
      "service": "voice_authentication"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "event_type"
      ],
      "enrichment_required": [
        {
          "field": "breath_sound_detected",
          "source": "Audio analysis enrichment (breath detection model)"
        },
        {
          "field": "codec_reencoding_detected",
          "source": "Audio analysis enrichment (codec fingerprinting pipeline)"
        },
        {
          "field": "pitch_variance",
          "source": "Audio analysis enrichment (voice characteristics analysis)"
        },
        {
          "field": "spectral_flatness_score",
          "source": "Audio analysis enrichment (spectral analysis pipeline)"
        }
      ]
    },
    "references": [
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf",
      "https://arxiv.org/abs/2308.14970"
    ],
    "threat_path_ids": [
      "TP-0007",
      "TP-0018"
    ],
    "fraud_types": [
      "deepfake-fraud"
    ],
    "tags": [
      "attack.t1656",
      "cfpf.phase4.execution",
      "flame.deepfake"
    ],
    "falsepositives": [
      "Callers using low-bandwidth VoIP connections with heavy compression",
      "Speech impairment conditions producing monotone or atypical vocal patterns",
      "Hearing-impaired callers using text-to-speech relay services legitimately"
    ]
  }
