  "data": {
    "id": "bc6400fa-4411-4a97-ab10-cfd48b15a347",
    "dl_id": "DL-0026",
    "title": "Account Type Conversion Anomaly",
    "status": "experimental",
    "description": "Detects suspicious account type conversions such as savings-to-checking or personal-to-business. These conversions can unlock higher transaction limits, wire capabilities, or ACH origination, which attackers exploit to move larger amounts after taking over a limited account.\n",
    "cfpf_phase": "P3",
    "level": "medium",
    "detection": {
      "selection": {
        "event_type": "ACCOUNT_TYPE_CONVERSION",
        "conversion_type": [
          "savings_to_checking",
          "personal_to_business",
          "basic_to_premium"
        ]
      },
      "selection_recent_credential_change": {
        "days_since_last_credential_change|lte": 7
      },
      "condition": "selection and selection_recent_credential_change"
    },
    "logsource": {
      "product": "banking",
      "service": "core_banking"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "conversion_type",
        "days_since_last_credential_change",
        "event_type"
      ]
    },
    "references": [
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf"
    ],
    "threat_path_ids": [
      "TP-0001",
      "TP-0005"
    ],
    "fraud_types": [
      "account-takeover",
      "wire-fraud"
    ],
    "tags": [
      "attack.t1098",
      "cfpf.phase3.positioning",
      "flame.account_modification"
    ],
    "falsepositives": [
      "Small business owners legitimately converting a personal account to a business account",
      "Customers upgrading account tiers for better interest rates or features"
    ]
  }
}