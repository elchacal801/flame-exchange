  "data": {
    "id": "4fafa273-ef85-4b98-94b1-7489a94a2b81",
    "dl_id": "DL-0003",
    "title": "Session Cookie Exfiltration Pattern",
    "status": "experimental",
    "description": "Detects session token and cookie theft patterns in log data indicative of infostealer activity. Stealers like Lumma and Raccoon target browser cookie stores to extract active session tokens, enabling session hijacking without requiring credentials. This rule monitors for suspicious access to cookie databases and exfiltration of session-bearing data.\n",
    "cfpf_phase": "P2",
    "level": "high",
    "detection": {
      "selection_cookie_db": {
        "file_path|contains": [
          "\\Cookies",
          "\\cookies.sqlite",
          "\\Network\\Cookies"
        ],
        "file_access_type": "read"
      },
      "selection_process": {
        "process_name|endswith": [
          ".exe"
        ],
        "process_signed": false
      },
      "filter_browsers": {
        "process_name|endswith": [
          "\\chrome.exe",
          "\\firefox.exe",
          "\\msedge.exe",
          "\\brave.exe"
        ]
      },
      "condition": "(selection_cookie_db and selection_process) and not filter_browsers"
    },
    "logsource": {
      "product": "banking",
      "service": "endpoint_detection"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "file_access_type",
        "file_path",
        "process_name",
        "process_signed"
      ]
    },
    "references": [
      "https://attack.mitre.org/techniques/T1539/",
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf"
    ],
    "threat_path_ids": [
      "TP-0001",
      "TP-0008"
    ],
    "fraud_types": [
      "account-takeover",
      "data-theft",
      "malware"
    ],
    "tags": [
      "attack.t1005",
      "attack.t1539",
      "cfpf.phase2.initial_access"
    ],
    "falsepositives": [
      "Third-party browser extensions with legitimate cookie management functionality",
      "Endpoint backup solutions that include browser profile data"
    ]
  }
}