    "dl_id": "DL-0023",
    "title": "Alert Threshold Modification",
    "status": "experimental",
    "description": "Detects when a user modifies their own transaction alert thresholds or disables notifications via online banking or mobile app. Attackers raise alert thresholds or suppress notifications to prevent the legitimate account holder from being alerted to unauthorized transactions.\n",
    "cfpf_phase": "P3",
    "level": "medium",
    "detection": {
      "selection_threshold_raise": {
        "event_type": "ALERT_SETTINGS_CHANGE",
        "action": [
          "threshold_increase",
          "notification_disable",
          "alert_suppress"
        ]
      },
      "selection_channel": {
        "channel": [
          "online_banking",
          "mobile_app",
          "api"
        ]
      },
      "condition": "selection_threshold_raise and selection_channel"
    },
    "logsource": {
      "product": "banking",
      "service": "core_banking"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "action",
        "channel",
        "event_type"
      ]
    },
    "references": [
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf"
    ],
    "threat_path_ids": [
      "TP-0001",
      "TP-0005"
    ],
    "fraud_types": [
      "account-takeover"
    ],
    "tags": [
      "attack.t1098",
      "cfpf.phase3.positioning",
      "flame.account_modification"
    ],
    "falsepositives": [
      "Customers who intentionally adjust alert settings to reduce notification fatigue",
      "Business accounts adjusting thresholds for expected high-value transactions"
    ]
  }
