    "dl_id": "DL-0025",
    "title": "Power of Attorney or Authorized Signer Change",
    "status": "experimental",
    "description": "Detects changes to power of attorney designations or authorized signers on commercial and business accounts. Fraudsters may socially engineer or forge POA documents to gain control of business accounts, enabling them to initiate high-value transactions.\n",
    "cfpf_phase": "P3",
    "level": "high",
    "detection": {
      "selection": {
        "event_type": [
          "POA_ADD",
          "POA_MODIFY",
          "AUTHORIZED_SIGNER_ADD",
          "AUTHORIZED_SIGNER_MODIFY"
        ],
        "account_type": [
          "commercial",
          "business",
          "corporate",
          "trust"
        ]
      },
      "selection_high_value": {
        "account_balance|gte": 50000
      },
      "condition": "selection and selection_high_value"
    },
    "logsource": {
      "product": "banking",
      "service": "core_banking"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "account_type",
        "event_type"
      ],
      "enrichment_required": [
        {
          "field": "account_balance",
          "source": "Core banking enrichment (real-time balance lookup)"
        }
      ]
    },
    "references": [
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf",
      "https://www.fincen.gov/sites/default/files/shared/FIN-2022-A002.pdf"
    ],
    "threat_path_ids": [
      "TP-0004",
      "TP-0005",
      "TP-0006"
    ],
    "fraud_types": [
      "account-takeover",
      "wire-fraud"
    ],
    "tags": [
      "attack.t1098",
      "cfpf.phase3.positioning",
      "flame.account_modification"
    ],
    "falsepositives": [
      "Legitimate corporate governance changes such as new CFO or treasurer appointment",
      "Succession planning updates on trust accounts"
    ]
  }
}