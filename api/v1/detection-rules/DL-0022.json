  "data": {
    "id": "c94fce3e-816a-4968-9836-ad36a4889b82",
    "dl_id": "DL-0022",
    "title": "Dormant Account Reactivation",
    "status": "experimental",
    "description": "Detects accounts with no transactional activity for 90 or more days that suddenly initiate financial transactions. Dormant accounts are frequently targeted by attackers because they are less likely to be monitored and credential compromise may go unnoticed.\n",
    "cfpf_phase": "P3",
    "level": "high",
    "detection": {
      "selection_reactivation": {
        "event_type": [
          "WIRE_INITIATION",
          "ACH_DEBIT",
          "ACH_CREDIT",
          "INTERNAL_TRANSFER"
        ],
        "account_dormancy_days|gte": 90
      },
      "filter_scheduled": {
        "transaction_type": "RECURRING_SCHEDULED"
      },
      "condition": "selection_reactivation and not filter_scheduled"
    },
    "logsource": {
      "product": "banking",
      "service": "core_banking"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "event_type",
        "transaction_type"
      ],
      "enrichment_required": [
        {
          "field": "account_dormancy_days",
          "source": "Account analytics enrichment (days since last transaction calculation)"
        }
      ]
    },
    "references": [
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf",
      "https://www.fincen.gov/sites/default/files/shared/FIN-2016-A003.pdf"
    ],
    "threat_path_ids": [
      "TP-0001",
      "TP-0004"
    ],
    "fraud_types": [
      "account-takeover",
      "wire-fraud"
    ],
    "tags": [
      "attack.t1098",
      "cfpf.phase3.positioning",
      "flame.account_modification"
    ],
    "falsepositives": [
      "Seasonal businesses that operate on annual cycles (e.g., tax preparation firms)",
      "Estate or trust accounts activated for legitimate distributions"
    ]
  }
}