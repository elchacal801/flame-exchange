  "data": {
    "id": "95681bb1-0586-4ae0-9c7a-7de0bd359b94",
    "dl_id": "DL-0007",
    "title": "Infostealer Exfiltration Archive Creation",
    "status": "experimental",
    "description": "Detects creation of archive files containing credential-related file patterns consistent with infostealer packaging behavior. Stealers like RedLine and Vidar collect credentials, cookies, autofill data, and crypto wallet files into a ZIP or RAR archive before exfiltrating them to the C2 server.\n",
    "cfpf_phase": "P2",
    "level": "high",
    "detection": {
      "selection_archive_creation": {
        "event_type": "file_create",
        "file_extension|contains": [
          ".zip",
          ".rar",
          ".7z"
        ]
      },
      "selection_archive_contents": {
        "archive_file_list|contains": [
          "passwords",
          "Login Data",
          "Cookies",
          "autofill",
          "wallet.dat",
          "seed",
          "credit_cards"
        ]
      },
      "selection_process_unsigned": {
        "process_signed": false,
        "process_path|contains": [
          "\\AppData\\Local\\Temp",
          "\\Users\\Public",
          "\\ProgramData"
        ]
      },
      "condition": "selection_archive_creation and (selection_archive_contents or selection_process_unsigned)"
    },
    "logsource": {
      "product": "banking",
      "service": "endpoint_detection"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "archive_file_list",
        "event_type",
        "file_extension",
        "process_path",
        "process_signed"
      ]
    },
    "references": [
      "https://attack.mitre.org/techniques/T1560/001/",
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf"
    ],
    "threat_path_ids": [
      "TP-0001",
      "TP-0023"
    ],
    "fraud_types": [
      "data-theft",
      "malware"
    ],
    "tags": [
      "attack.t1005",
      "attack.t1560.001",
      "cfpf.phase2.initial_access"
    ],
    "falsepositives": [
      "Legitimate backup software creating archives of user profile data",
      "IT support tools collecting diagnostic bundles that include browser data"
    ]
  }
}