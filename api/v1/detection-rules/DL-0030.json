  "data": {
    "id": "5ef0b936-e74f-4bac-9f40-8b8b318a7296",
    "dl_id": "DL-0030",
    "title": "After-Hours Wire Transfer Initiation",
    "status": "experimental",
    "description": "Detects wire transfers initiated outside the account's established normal business hours. Attackers often execute unauthorized wires during evenings, weekends, or holidays when fraud detection staff and account holders are less likely to notice.\n",
    "cfpf_phase": "P4",
    "level": "high",
    "detection": {
      "selection": {
        "event_type": "WIRE_INITIATION",
        "transaction_amount|gte": 5000,
        "initiated_outside_business_hours": true
      },
      "selection_channel": {
        "channel": [
          "online_banking",
          "mobile_app",
          "api"
        ]
      },
      "filter_pre_authorized": {
        "wire_status": "pre_authorized_recurring"
      },
      "condition": "selection and selection_channel and not filter_pre_authorized"
    },
    "logsource": {
      "product": "banking",
      "service": "wire_system"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "channel",
        "event_type",
        "initiated_outside_business_hours",
        "transaction_amount",
        "wire_status"
      ]
    },
    "references": [
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf",
      "https://www.fincen.gov/sites/default/files/advisory/2019-10-01/BEC_Advisory_FINAL_508.pdf"
    ],
    "threat_path_ids": [
      "TP-0001",
      "TP-0006"
    ],
    "fraud_types": [
      "account-takeover",
      "wire-fraud"
    ],
    "tags": [
      "attack.t1657",
      "cfpf.phase4.execution",
      "flame.wire_ach"
    ],
    "falsepositives": [
      "International businesses operating across time zones with legitimate after-hours activity",
      "Business owners making urgent payments during personal hours"
    ]
  }
}