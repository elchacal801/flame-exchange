  "data": {
    "id": "a71a2d8b-6843-415c-9c2a-8993b4ee95a4",
    "dl_id": "DL-0010",
    "title": "Autofill Data Harvesting",
    "status": "experimental",
    "description": "Detects form autofill data extraction patterns consistent with infostealer behavior. Stealers like RedLine and Raccoon target browser autofill databases (Web Data, formhistory.sqlite) to harvest stored PII including names, addresses, phone numbers, and payment card details that facilitate downstream fraud.\n",
    "cfpf_phase": "P2",
    "level": "medium",
    "detection": {
      "selection": {
        "file_path|endswith": [
          "\\Web Data",
          "\\Web Data-journal",
          "\\formhistory.sqlite",
          "\\Form History"
        ],
        "file_access_type": "read"
      },
      "filter_browsers": {
        "process_name|endswith": [
          "\\chrome.exe",
          "\\firefox.exe",
          "\\msedge.exe",
          "\\brave.exe"
        ]
      },
      "filter_system": {
        "process_integrity_level": "System"
      },
      "condition": "selection and not filter_browsers and not filter_system"
    },
    "logsource": {
      "product": "banking",
      "service": "endpoint_detection"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "file_access_type",
        "file_path",
        "process_integrity_level",
        "process_name"
      ]
    },
    "references": [
      "https://attack.mitre.org/techniques/T1555/003/",
      "https://www.fsisac.com/hubfs/Knowledge/Fraud/CyberFraudPreventionFramework.pdf"
    ],
    "threat_path_ids": [
      "TP-0001",
      "TP-0023"
    ],
    "fraud_types": [
      "account-takeover",
      "data-theft",
      "malware"
    ],
    "tags": [
      "attack.t1005",
      "attack.t1555.003",
      "cfpf.phase2.initial_access"
    ],
    "falsepositives": [
      "Browser profile migration utilities reading autofill databases during import",
      "Form-filling accessibility tools for users with disabilities"
    ]
  }
}