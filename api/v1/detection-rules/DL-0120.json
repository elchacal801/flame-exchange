    "dl_id": "DL-0120",
    "title": "Investment TDS Geo-Routing to Legitimate Platform",
    "status": "experimental",
    "description": "Detect Traffic Distribution System (TDS) geo-routing patterns used in investment scam infrastructure: (1) same domain resolving to different IP addresses based on requester geography, (2) US-based visitors redirected to legitimate financial services such as eToro or Coinbase while non-US visitors are routed to newly registered scam domains, (3) CNAME records functioning as TDS routing mechanisms as observed in Savvy Seahorse campaigns. This evasion technique allows scam operators to avoid detection by security researchers and law enforcement in specific jurisdictions.\n",
    "cfpf_phase": "P3",
    "level": "medium",
    "detection": {
      "selection_geo_variance": {
        "domain_ip_geo_variance": true,
        "unique_resolution_ips|gte": 3,
        "geo_routing_detected": true
      },
      "selection_legitimate_redirect": {
        "redirect_target|contains": [
          "etoro.com",
          "coinbase.com",
          "robinhood.com",
          "fidelity.com"
        ],
        "source_geo": "US"
      },
      "selection_cname_tds": {
        "cname_chain_length|gte": 2,
        "cname_target_domain_age_days|lt": 30,
        "cname_routing_pattern": true
      },
      "selection_domain_age": {
        "domain_registration_age_days|lt": 30,
        "non_us_redirect_target": true
      },
      "condition": "(selection_geo_variance and selection_legitimate_redirect) or (selection_cname_tds and selection_domain_age)"
    },
    "logsource": {
      "product": "dns",
      "service": "passive_dns"
    },
    "sigma_compatible": true,
    "data_sources": {
      "native_fields": [
        "domain_ip_geo_variance",
        "unique_resolution_ips",
        "geo_routing_detected",
        "redirect_target",
        "source_geo",
        "cname_chain_length",
