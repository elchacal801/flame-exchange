/* FLAME logsource mapping -- field names and index patterns require environment-specific tuning. */

((file_path:(*\\Login\ Data OR *\\Login\ Data\-journal OR *\\logins.json OR *\\key4.db OR *\\key3.db OR *\\signons.sqlite)) AND (file_access_type:(*read* OR *open*))) AND (NOT (process_name:(*\\chrome.exe OR *\\firefox.exe OR *\\msedge.exe OR *\\brave.exe OR *\\opera.exe OR *\\vivaldi.exe))) AND (NOT (process_name:(*antivirus* OR *defender* OR *security*)))
