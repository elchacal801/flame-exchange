// FLAME logsource mapping -- table names and field names require environment-specific tuning.

((file_path endswith "\\Web Data" or file_path endswith "\\Web Data-journal" or file_path endswith "\\formhistory.sqlite" or file_path endswith "\\Form History") and file_access_type =~ "read") and (not((process_name endswith "\\chrome.exe" or process_name endswith "\\firefox.exe" or process_name endswith "\\msedge.exe" or process_name endswith "\\brave.exe"))) and (not(process_integrity_level =~ "System"))
