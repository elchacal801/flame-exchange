// FLAME logsource mapping -- table names and field names require environment-specific tuning.

((file_path endswith "\\Login Data" or file_path endswith "\\Login Data-journal" or file_path endswith "\\logins.json" or file_path endswith "\\key4.db" or file_path endswith "\\key3.db" or file_path endswith "\\signons.sqlite") and (file_access_type contains "read" or file_access_type contains "open")) and (not((process_name endswith "\\chrome.exe" or process_name endswith "\\firefox.exe" or process_name endswith "\\msedge.exe" or process_name endswith "\\brave.exe" or process_name endswith "\\opera.exe" or process_name endswith "\\vivaldi.exe"))) and (not((process_name contains "antivirus" or process_name contains "defender" or process_name contains "security")))
