/* FLAME logsource mapping -- field names and index patterns require environment-specific tuning. */

(transaction_type:contactless AND (entry_mode:(*wallet_nfc* OR *contactless_emv* OR *tap_to_pay*))) AND (count:>=3 AND groupby:wallet_token_id AND timeframe:30m) AND (dc_terminal_id:>=3 OR dc_terminal_city:>=2)
