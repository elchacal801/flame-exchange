// FLAME logsource mapping -- table names and field names require environment-specific tuning.

((src_page_uri contains "/checkout" or src_page_uri contains "/payment" or src_page_uri contains "/billing" or src_page_uri contains "/cart/complete") and (dst_domain contains "infura.io" or dst_domain contains "alchemy.com" or dst_domain contains "etherscan.io" or dst_domain contains "bscscan.com" or dst_domain contains "cloudflare-eth.com" or dst_domain contains "ankr.com") and request_method =~ "POST" and (request_body contains "eth_call" or request_body contains "eth_getStorageAt" or request_body contains "eth_getLogs")) or (((src_page_uri contains "/checkout" or src_page_uri contains "/payment" or src_page_uri contains "/billing") and connection_type =~ "websocket") and (not((dst_domain contains "stripe.com" or dst_domain contains "paypal.com" or dst_domain contains "braintreegateway.com" or dst_domain contains "adyen.com" or dst_domain contains "authorize.net" or dst_domain contains "cybersource.com" or dst_domain contains "worldpay.com" or dst_domain contains "square.com" or dst_domain contains "shopify.com"))))
