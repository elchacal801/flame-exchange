// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(event_type =~ "csp_violation" and (page_uri contains "/checkout" or page_uri contains "/payment" or page_uri contains "/billing" or page_uri contains "/cart/complete") and blocked_uri matches regex "https?://[^/]+\\.[a-z]{2,}") or ((event_type =~ "script_load" and (page_uri contains "/checkout" or page_uri contains "/payment" or page_uri contains "/billing") and script_domain_age_days <= 90) and (not((script_domain contains "google-analytics.com" or script_domain contains "googletagmanager.com" or script_domain contains "googleapis.com" or script_domain contains "gstatic.com")))) or (event_type =~ "gtm_container_update" and (change_type contains "tag_created" or change_type contains "tag_modified" or change_type contains "custom_html_added"))
