// FLAME logsource mapping -- table names and field names require environment-specific tuning.

((event_type contains "dom_mutation" or event_type contains "element_injected" or event_type contains "form_modified" or event_type contains "iframe_created") and (page_uri contains "/checkout" or page_uri contains "/payment" or page_uri contains "/billing") and (target_element contains "payment-form" or target_element contains "card-number" or target_element contains "cc-number" or target_element contains "card-expiry" or target_element contains "card-cvc" or target_element contains "billing-address" or target_element contains "submit-payment")) and (not((isnotempty(deployment_id) and deployment_window =~ true))) and (not((mutation_source contains "react" or mutation_source contains "angular" or mutation_source contains "vue" or mutation_source contains "next" or mutation_source contains "nuxt")))
