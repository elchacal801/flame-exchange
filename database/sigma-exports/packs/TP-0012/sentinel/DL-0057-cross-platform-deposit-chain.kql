// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(event_type =~ "payment_received" and (inbound_rail contains "ACH_IN" or inbound_rail contains "WIRE_IN" or inbound_rail contains "RTP_IN" or inbound_rail contains "FEDNOW_IN")) and (event_type =~ "instant_payment_initiated" and (outbound_rail contains "ZELLE" or outbound_rail contains "FEDNOW" or outbound_rail contains "RTP" or outbound_rail contains "ACH_SAMEDAY")) and outbound_amount_pct_of_inbound >= 80
