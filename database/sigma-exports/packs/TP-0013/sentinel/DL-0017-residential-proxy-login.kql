// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(event_type contains "login_attempt" or event_type contains "login_success") and ((source_ip_threat_intel contains "residential_proxy" or source_ip_threat_intel contains "proxy_network") and source_ip_category =~ "residential" and source_asn_type =~ "isp") and auth_result =~ "success"
