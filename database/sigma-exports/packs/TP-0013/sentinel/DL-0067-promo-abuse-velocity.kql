// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(event_type =~ "order_placed" and promo_code_applied =~ true) and (device_fingerprint_promo_uses_30d > 5 or source_ip_promo_uses_30d > 10 or payment_method_hash_promo_uses_30d > 5 or (account_age_days < 7 and (promo_type contains "new_customer" or promo_type contains "referral_bonus" or promo_type contains "first_order")))
