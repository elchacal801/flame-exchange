` FLAME logsource mapping -- field names, index, and sourcetype require environment-specific tuning. `


| rex field=request_domain "(?<request_domainMatch>(?i)(book[1i!l]ng|b00king|booking-?\\w+)\\.(com|net|org|info|travel|xyz|top))"
| eval request_domainCondition=if(isnotnull(request_domainMatch), "true", "false")
| rex field=request_domain "(?<request_domainMatch2>(?i)(exped[1i!l]a|exp3dia|expedia-?\\w+)\\.(com|net|org|info|travel|xyz|top))"
| eval request_domainCondition2=if(isnotnull(request_domainMatch2), "true", "false")
| rex field=request_domain "(?<request_domainMatch3>(?i)(a[1i!l]rbnb|airbnb-?\\w+|a1rbnb)\\.(com|net|org|info|travel|xyz|top))"
| eval request_domainCondition3=if(isnotnull(request_domainMatch3), "true", "false")
| rex field=request_domain "(?<request_domainMatch4>(?i)(hotels?-?\\w*book|book-?\\w*travel|cheap-?\\w*flight)\\.(com|net|org|info|travel))"
| eval request_domainCondition4=if(isnotnull(request_domainMatch4), "true", "false")
| search request_domainCondition="true" OR request_domainCondition2="true" OR request_domainCondition3="true" OR request_domainCondition4="true" NOT (request_domain IN ("booking.com", "*.booking.com", "expedia.com", "*.expedia.com", "airbnb.com", "*.airbnb.com", "hotels.com", "*.hotels.com")) domain_registration_age_days<30
