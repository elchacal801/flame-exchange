// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(event_type contains "phone_number_change" or event_type contains "sim_swap" or event_type contains "mobile_update") and (event_type =~ "password_reset" and reset_method =~ "sms_otp") and ((event_type contains "wire_transfer" or event_type contains "beneficiary_add" or event_type contains "address_change" or event_type contains "email_change") and transaction_amount >= 1000)
