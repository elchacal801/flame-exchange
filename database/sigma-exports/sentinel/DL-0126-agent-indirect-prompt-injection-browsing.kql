// FLAME logsource mapping -- table names and field names require environment-specific tuning.

event_type =~ "agent_content_ingestion" and ((content_contains_hidden_text =~ true and hidden_text_pattern matches regex "(?i)(\\$?CartMandate|cart_mandate|line.?item|recipient.?email|display.?status.*hidden)") or (content_contains_hidden_text =~ true and hidden_text_pattern matches regex "(?i)(settlement\\.refund|order\\.return\\.verify|refund\\.instant|void-\\d+|skip.*verify)") or (invisible_span_detected =~ true and invisible_content_length > 50 and invisible_content_contains_instructions =~ true) or (metadata_contains_instructions =~ true and metadata_instruction_pattern matches regex "(?i)(system:|action:|observation:)"))
