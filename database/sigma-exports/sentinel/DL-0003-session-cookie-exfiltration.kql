// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(((file_path contains "\\Cookies" or file_path contains "\\cookies.sqlite" or file_path contains "\\Network\\Cookies") and file_access_type =~ "read") and (process_name endswith ".exe" and process_signed =~ false)) and (not((process_name endswith "\\chrome.exe" or process_name endswith "\\firefox.exe" or process_name endswith "\\msedge.exe" or process_name endswith "\\brave.exe")))
