// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(event_type =~ "order_placed" and billing_shipping_address_match =~ false) and ((shipping_address_type contains "freight_forwarder" or shipping_address_type contains "reshipper" or shipping_address_type contains "po_box" or shipping_address_type contains "commercial_mailbox") or shipping_address_distinct_accounts > 3 or shipping_address_orders_7d > 5)
