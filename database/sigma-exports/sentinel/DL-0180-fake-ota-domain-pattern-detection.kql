// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(request_domain matches regex "(?i)(book[1i!l]ng|b00king|booking-?\\w+)\\.(com|net|org|info|travel|xyz|top)" or request_domain matches regex "(?i)(exped[1i!l]a|exp3dia|expedia-?\\w+)\\.(com|net|org|info|travel|xyz|top)" or request_domain matches regex "(?i)(a[1i!l]rbnb|airbnb-?\\w+|a1rbnb)\\.(com|net|org|info|travel|xyz|top)" or request_domain matches regex "(?i)(hotels?-?\\w*book|book-?\\w*travel|cheap-?\\w*flight)\\.(com|net|org|info|travel)") and (not((request_domain in~ ("booking.com", "expedia.com", "airbnb.com", "hotels.com") or request_domain endswith ".booking.com" or request_domain endswith ".expedia.com" or request_domain endswith ".airbnb.com" or request_domain endswith ".hotels.com"))) and domain_registration_age_days < 30
