// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(transaction_type =~ "contactless" and (entry_mode contains "wallet_nfc" or entry_mode contains "contactless_emv" or entry_mode contains "tap_to_pay")) and (count >= 3 and groupby =~ "wallet_token_id" and timeframe =~ "30m") and (dc_terminal_id >= 3 or dc_terminal_city >= 2)
