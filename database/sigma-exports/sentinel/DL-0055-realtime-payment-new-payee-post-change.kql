// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(event_type =~ "instant_payment_initiated" and (payment_rail contains "ZELLE" or payment_rail contains "FEDNOW" or payment_rail contains "RTP" or payment_rail contains "ACH_SAMEDAY") and payee_relationship =~ "new") and credential_change_hours_ago < 24
