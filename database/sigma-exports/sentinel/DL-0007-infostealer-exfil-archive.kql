// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(event_type =~ "file_create" and (file_extension contains ".zip" or file_extension contains ".rar" or file_extension contains ".7z")) and ((archive_file_list contains "passwords" or archive_file_list contains "Login Data" or archive_file_list contains "Cookies" or archive_file_list contains "autofill" or archive_file_list contains "wallet.dat" or archive_file_list contains "seed" or archive_file_list contains "credit_cards") or (process_signed =~ false and (process_path contains "\\AppData\\Local\\Temp" or process_path contains "\\Users\\Public" or process_path contains "\\ProgramData")))
