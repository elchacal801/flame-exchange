// FLAME logsource mapping -- table names and field names require environment-specific tuning.

(event_type =~ "WIRE_INITIATION" and wire_type =~ "international" and (beneficiary_country in~ ("MM", "KP", "IR", "YE", "SY", "HT", "VU", "PH", "NG", "SS")) and transaction_amount >= 1000) and (not((beneficiary_relationship_days >= 365 and prior_transaction_count >= 10)))
