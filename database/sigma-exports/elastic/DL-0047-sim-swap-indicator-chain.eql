/* FLAME logsource mapping -- field names and index patterns require environment-specific tuning. */

(event_type:(*phone_number_change* OR *sim_swap* OR *mobile_update*)) AND (event_type:password_reset AND reset_method:sms_otp) AND ((event_type:(*wire_transfer* OR *beneficiary_add* OR *address_change* OR *email_change*)) AND transaction_amount:>=1000)
